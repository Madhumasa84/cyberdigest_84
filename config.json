{
    "interval_days": 3,
    "max_archived_reports": 30,
    "archive_global": true,
    "max_articles_per_feed": 8,
    "max_articles_per_network_feed": 5,
    "log_level": "INFO",
    "critical_keywords": [
        "cve-",
        "zero-day",
        "0-day",
        "actively exploited",
        "rce",
        "ransomware",
        "breach"
    ],
    "high_keywords": [
        "vulnerability",
        "flaw",
        "patch"
    ],
    "nvd_enabled": true,
    "nvd_max_lookups": 15,
    "nvd_timeout_seconds": 25
}
